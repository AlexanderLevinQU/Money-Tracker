<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoneyTracker.UI.Views.Controls.PeriodSelector">

    <StackLayout Spacing="8">
        <Label Text="Period:" FontSize="14" FontAttributes="Bold" TextColor="#333" Margin="0,5,0,0"/>
        <HorizontalStackLayout Spacing="8">
            <Button Text="Day" Command="{Binding Dashboard.ChangePeriodCommand}" CommandParameter="Day"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="Day">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Week" Command="{Binding Dashboard.ChangePeriodCommand}" CommandParameter="Week"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="Week">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Month" Command="{Binding Dashboard.ChangePeriodCommand}" CommandParameter="Month"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="Month">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Calendar Year" Command="{Binding Dashboard.ChangePeriodCommand}" CommandParameter="CalendarYear"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="CalendarYear">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Fiscal Year" Command="{Binding Dashboard.ChangePeriodCommand}" CommandParameter="FiscalYear"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="FiscalYear">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Custom Range" Command="{Binding Dashboard.ShowCustomPeriodCommand}"
                    BackgroundColor="#E0E0E0" TextColor="#333"
                    CornerRadius="6" Padding="10,5"
                    HorizontalOptions="FillAndExpand" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Dashboard.TimePeriod}" Value="Custom">
                        <Setter Property="BackgroundColor" Value="#0D47A1" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <!-- Filter controls: moved here from TransactionsList -->
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="0,6,0,0">
            <Picker Title="Filter" WidthRequest="140" VerticalOptions="Center"
                    ItemsSource="{Binding Dashboard.FilterOptions}" SelectedItem="{Binding Dashboard.SelectedFilter, Mode=TwoWay}" />
            <Picker Title="Category" WidthRequest="200" VerticalOptions="Center"
                    ItemsSource="{Binding Dashboard.AvailableCategories}" SelectedItem="{Binding Dashboard.FilterCategory, Mode=TwoWay}"
                    IsVisible="{Binding Dashboard.IsCategoryFilterVisible}" />
        </HorizontalStackLayout>

        <!-- Custom range pickers -->
        <StackLayout Orientation="Horizontal" Spacing="8" Padding="0,8,0,0">
            <StackLayout.Triggers>
                <DataTrigger TargetType="StackLayout" Binding="{Binding Dashboard.TimePeriod}" Value="Custom">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </StackLayout.Triggers>
            <DatePicker Date="{Binding Dashboard.CustomStartDate, Mode=TwoWay}" />
            <DatePicker Date="{Binding Dashboard.CustomEndDate, Mode=TwoWay}" />
            <Button Text="Apply" Command="{Binding Dashboard.ApplyCustomPeriodCommand}" />
        </StackLayout>
    </StackLayout>

</ContentView>
