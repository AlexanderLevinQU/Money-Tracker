<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoneyTracker.UI.Views.Controls.SummaryCards">

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
        <Frame Grid.Row="0" Grid.Column="0"
               CornerRadius="12"
               HasShadow="True"
               Padding="15"
               BorderColor="#E0E0E0">
            <VerticalStackLayout Spacing="8">
                <Label Text="Total Income" FontSize="12" TextColor="#666"/>
                <Label Text="{Binding Dashboard.TotalIncome, StringFormat='${0:F2}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#4CAF50"/>
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="0" Grid.Column="1"
               CornerRadius="12"
               HasShadow="True"
               Padding="15"
               BorderColor="#E0E0E0">
            <VerticalStackLayout Spacing="8">
                <Label Text="Total Expenses" FontSize="12" TextColor="#666"/>
                <Label Text="{Binding Dashboard.TotalExpenses, StringFormat='${0:F2}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#F44336"/>
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               CornerRadius="12"
               HasShadow="True"
               Padding="15"
               BackgroundColor="#0D47A1">
            <VerticalStackLayout Spacing="8">
                <Label Text="Net Balance" FontSize="12" TextColor="White" Opacity="0.8"/>
                <Label Text="{Binding Dashboard.NetBalance, StringFormat='${0:F2}'}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentView>
