<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MoneyTracker.UI.Converters"
             x:Class="MoneyTracker.UI.Views.Controls.TransactionsList">

    <!-- Resources cleaned: removed unused SliderToColorConverter -->

    <StackLayout Spacing="8">
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label Text="Recent Transactions" FontSize="14" FontAttributes="Bold" TextColor="#333" Margin="0,5,0,0" VerticalOptions="Center" />
            <!-- Filter controls moved to PeriodSelector -->
        </HorizontalStackLayout>
        <CollectionView x:Name="TransactionsView"
                        ItemsSource="{Binding Dashboard.Transactions}"
                        SelectionMode="Single"
                        EmptyView="No transactions found"
                        VerticalOptions="FillAndExpand"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding Dashboard.LoadMoreTransactionsCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,10" Padding="15" CornerRadius="8" HasShadow="True" BorderColor="#E0E0E0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemGridTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
                                <Label Text="{Binding Description}" FontSize="12" TextColor="#999"/>
                                <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}" FontSize="11" TextColor="#CCC"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   x:Name="AmountLabel"
                                   Text="{Binding Amount, StringFormat='${0:F2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#333"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   Margin="0,0,6,0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Expense">
                                        <Setter Property="TextColor" Value="#D9534F" />
                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='(${0:F2})'}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Income">
                                        <Setter Property="TextColor" Value="#28a745" />
                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='${0:F2}'}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <!-- red square indicator (tappable) -->
                            <Grid Grid.Column="2">
                                <Button x:Name="IndicatorButton"
                                        CornerRadius="0"
                                        BackgroundColor="#D9534F"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        Margin="0"
                                        Clicked="OnIndicatorTapped" />

                                <Button x:Name="ConfirmRemoveButton"
                                        Text="Remove"
                                        FontSize="12"
                                        Padding="6,4"
                                        BackgroundColor="#D9534F"
                                        TextColor="White"
                                        IsVisible="False"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Clicked="OnConfirmRemoveClicked" />
                            </Grid>
                                <!-- no slider: indicator button toggles confirm remove -->
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <StackLayout Padding="8" HorizontalOptions="FillAndExpand">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="CenterAndExpand">
                        <ActivityIndicator IsRunning="{Binding Dashboard.IsLoading}" IsVisible="{Binding Dashboard.IsLoading}" />
                        <Label Text="Loading more..." IsVisible="{Binding Dashboard.IsLoading}" VerticalOptions="Center" />
                        <Button Text="Load more" Command="{Binding Dashboard.LoadMoreTransactionsCommand}" IsVisible="{Binding Dashboard.HasMore}" />
                    </HorizontalStackLayout>
                </StackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </StackLayout>

</ContentView>
