<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MoneyTracker.UI.Views.Controls"
             x:Class="MoneyTracker.UI.MainPage"
             Title=""
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*" Padding="20">
            <!-- Header -->
            <StackLayout Grid.Row="0" Spacing="15" Padding="0,0,0,15">
                <Label Text="Money Tracker" FontSize="28" FontAttributes="Bold" TextColor="#0D47A1"/>
                
                <!-- Profile Picker -->
                <StackLayout Spacing="5">
                    <Label Text="Profile:" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
                    <Picker x:Name="ProfilePicker" 
                            Title="Select Profile"
                            ItemsSource="{Binding Profiles}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedProfile}"
                            BackgroundColor="White"
                            TextColor="#333"/>
                </StackLayout>

                <!-- Action Buttons -->
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Add Transaction" 
                            Command="{Binding AddTransactionCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            IsEnabled="True"
                            HorizontalOptions="FillAndExpand"/>
                    <Button Text="New Profile" 
                            Command="{Binding NewProfileCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            IsEnabled="True"
                            HorizontalOptions="FillAndExpand"/>
                        <Button Text="Remove Profile"
                            Command="{Binding RemoveProfileCommand}"
                            BackgroundColor="#F44336"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            IsEnabled="True"
                            HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </StackLayout>

            <!-- Content -->
            <!-- summary and period selector moved to small controls -->
            <ContentView Grid.Row="1">
                <!-- placeholder: SummaryCards will render using inherited BindingContext -->
                <views:SummaryCards />
            </ContentView>
            <ContentView Grid.Row="2">
                <views:PeriodSelector />
            </ContentView>

            <!-- Recent Transactions -->
            <views:TransactionsList Grid.Row="3" HeightRequest="200"/>
        </Grid> 
    </ScrollView>
</ContentPage>
